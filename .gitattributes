# Normalize line endings so contributors on different platforms do not
# produce whole-file diffs. Checked out with native endings, stored as LF.
* text=auto eol=lf

# Unity text assets
*.cs            text diff=csharp
*.shader        text
*.asmdef        text eol=lf
*.unity         text eol=lf
*.asset         text eol=lf
*.prefab        text eol=lf
*.mat           text eol=lf
*.meta          text eol=lf
*.md            text

# Unity binary assets: never diff or merge these
*.png           binary
*.jpg           binary
*.tga           binary
*.psd           binary
*.fbx           binary
*.blend         binary
*.wav           binary
*.mp3           binary
*.ogg           binary
*.unitypackage  binary
